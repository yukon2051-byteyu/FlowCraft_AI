# FlowCraft AI 環境変数の見本
# このファイルをコピーして「.env」という名前で保存し、値を設定してください。
# .env は .gitignore によりGitに含まれません。実際のAPIキーはこのファイルに書かないこと。

# ----- Claude API -----
# 未設定の場合は「固定応答モード（AI未接続）」で動作します
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
# 月間のAI利用上限（米ドル）。超えるとAI機能のみ停止します
AI_MONTHLY_BUDGET_USD=10

# ----- ファイル制限 -----
MAX_FILES=5
MAX_FILE_SIZE_MB=10
MAX_TOTAL_ROWS=100000
MAX_INTERMEDIATE_ROWS=500000

# ----- セッション -----
# 最終操作からこの分数が経過したデータを自動削除します
SESSION_TTL_MINUTES=60
RUN_TIMEOUT_SECONDS=60
