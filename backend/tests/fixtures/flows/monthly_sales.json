{
  "schema_version": "1.0",
  "engine_version": "0.1.0",
  "flow_id": "6f1c2b9e-3d4a-4c1e-9a8b-2f6e5d4c3b2a",
  "flow_version": 1,
  "flow_name": "月次売上集計",
  "description": "売上実績を商品マスタ・部署マスタと結合し、部署別・商品別に集計する（架空データ用）",
  "created_at": "2026-11-12T10:00:00+09:00",
  "updated_at": "2026-11-12T10:00:00+09:00",
  "input_definitions": [
    {
      "input_id": "sales",
      "label": "売上実績",
      "file_kind": "xlsx",
      "sheet_hint": "売上",
      "columns": [
        { "name": "売上日", "type": "date" },
        { "name": "部署コード", "type": "string" },
        { "name": "商品コード", "type": "string" },
        { "name": "数量", "type": "integer" },
        { "name": "金額", "type": "decimal", "scale": 0 },
        { "name": "備考", "type": "string", "required": false }
      ]
    },
    {
      "input_id": "products",
      "label": "商品マスタ",
      "file_kind": "xlsx",
      "columns": [
        { "name": "商品コード", "type": "string" },
        { "name": "商品名", "type": "string" }
      ]
    },
    {
      "input_id": "depts",
      "label": "部署マスタ",
      "file_kind": "csv",
      "columns": [
        { "name": "部署コード", "type": "string" },
        { "name": "部署名", "type": "string" }
      ]
    }
  ],
  "nodes": [
    {
      "node_id": "n1",
      "node_type": "load",
      "node_name": "売上実績を読み込む",
      "parameters": { "input_id": "sales" },
      "output_reference": "sales",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n2",
      "node_type": "select_columns",
      "node_name": "必要な列を抽出",
      "parameters": { "columns": ["売上日", "部署コード", "商品コード", "数量", "金額"] },
      "input_references": ["sales"],
      "output_reference": "sales_selected",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n3",
      "node_type": "load",
      "node_name": "商品マスタを読み込む",
      "parameters": { "input_id": "products" },
      "output_reference": "products",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n4",
      "node_type": "join",
      "node_name": "商品マスタと結合",
      "parameters": {
        "keys": [{ "left": "商品コード", "right": "商品コード" }],
        "how": "left",
        "expected_relationship": "many_to_one",
        "unmatched_policy": "warn",
        "check_amount_columns": ["金額"]
      },
      "input_references": ["sales_selected", "products"],
      "output_reference": "sales_p",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n5",
      "node_type": "load",
      "node_name": "部署マスタを読み込む",
      "parameters": { "input_id": "depts" },
      "output_reference": "depts",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n6",
      "node_type": "join",
      "node_name": "部署マスタと結合",
      "parameters": {
        "keys": [{ "left": "部署コード", "right": "部署コード" }],
        "how": "left",
        "expected_relationship": "many_to_one",
        "check_amount_columns": ["金額"]
      },
      "input_references": ["sales_p", "depts"],
      "output_reference": "sales_full",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n7",
      "node_type": "aggregate",
      "node_name": "部署別に売上を集計",
      "parameters": {
        "group_by": ["部署名"],
        "aggregations": [
          { "function": "sum", "column": "金額", "output_column": "売上合計", "scale": 0 },
          { "function": "count", "output_column": "件数" }
        ]
      },
      "input_references": ["sales_full"],
      "output_reference": "by_dept",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n8",
      "node_type": "aggregate",
      "node_name": "商品別に売上を集計",
      "parameters": {
        "group_by": ["商品コード", "商品名"],
        "aggregations": [{ "function": "sum", "column": "金額", "output_column": "売上合計", "scale": 0 }]
      },
      "input_references": ["sales_full"],
      "output_reference": "by_product",
      "confirmation_status": "confirmed"
    },
    {
      "node_id": "n9",
      "node_type": "output",
      "node_name": "Excelに出力",
      "parameters": {
        "sheets": [
          { "reference": "by_dept", "sheet_name": "部署別売上" },
          { "reference": "by_product", "sheet_name": "商品別売上" },
          { "reference": "sales_full", "sheet_name": "明細" }
        ]
      },
      "input_references": ["by_dept", "by_product", "sales_full"],
      "confirmation_status": "confirmed"
    }
  ]
}
