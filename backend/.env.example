# backend/.env の見本（このファイルには秘密の値を書かない）。
# 使うときは backend/.env に写して、値を書き込む。backend/.env は Git で公開されない設定（.gitignore）。
# AIを使わないなら、このファイルは不要（AIの操作は「利用できません」と表示し、AIなしの手順作成を案内する）。

# Anthropic の APIキー（費用が発生する。他人に見せない）
ANTHROPIC_API_KEY=

# AI使用パスワードのハッシュ。作り方：.venv\Scripts\python.exe -m app.ai.password
# （パスワードそのものは書かない。表示された AI_PASSWORD_HASH=... の行をそのまま貼る）
AI_PASSWORD_HASH=

# 月の費用の上限（ドル）と、1セッションの1時間あたりの回数
AI_MONTHLY_BUDGET_USD=10
AI_CALLS_PER_HOUR=20

# AIの動かし方：auto（APIキーとパスワードがあれば使う）／off（使わない）／fixed（固定応答。テスト・開発用で費用なし）
AI_MODE=auto
