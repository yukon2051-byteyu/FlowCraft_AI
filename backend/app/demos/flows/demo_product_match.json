      "node_name": "商品マスタと照合して商品名・カテゴリを付け加える",
      "parameters": {
        "keys": [
          {
            "left": "商品コード",
            "right": "商品コード"
          }
        ],
        "how": "left",
        "expected_relationship": "many_to_one",
        "unmatched_policy": "warn",
